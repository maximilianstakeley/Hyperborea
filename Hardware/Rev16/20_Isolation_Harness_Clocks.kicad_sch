(kicad_sch (version 20250114) (generator "eeschema") (uuid "e3b8b0a5-5d8e-4b7c-a06b-3b8f21c4b242") (paper "User" 594 460) (title_block (title "20 | Isolation boundary, harness and clock implementation") (date "2026-11-17") (rev "16") (comment 1 "ENGINEERING REVISION - BENCH PROTOTYPE; NOT PATIENT-RELEASED")) (lib_symbols) (text "20 | Isolation boundary, harness and clock implementation" (at 12 20 0) (effects (font (size 2 2)) (justify left)) (uuid "182e112d-8480-4451-b14a-13b0a73e401b")) (text "External power: MeanWellGSM18U09-P1J,9V2A,2MOPP adapter candidate. Verify current certificates and exact market mains cord/plug." (at 12 42 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "e91b5df6-b03e-443c-9125-746f1f85c99e")) (text "Board DC inletPJ-102AH: pin1positive9V, pin2return, pin3switch NC. Never substitute an earth-referenced laboratory supply in patient mode." (at 12 55 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "53d88bd9-454a-4726-8252-af2d5f6326f8")) (text "USB: ISOUSB111DWR wideSOIC16; no DC connection between USB_HOST_GND/shield and patient-sideMCU_GND/AGND." (at 12 68 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "dcdc8fec-ec1a-425a-9588-9857ed2bdffa")) (text "USB isolator component rating is not system certification. Maintain datasheet creepage/clearance and required PCB slots/keepouts." (at 12 81 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "25bab9b3-212e-47bf-88e0-592acf2c9d63")) (text "USB shield terminates host ground only. Enclosure nonconductive. No added Y-cap, shield braid or mounting hardware bridges barrier." (at 12 94 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "f69322db-e32e-454d-a818-01c53d8b2e93")) (text "AGND, AFE_DGND and MCU_GND are same galvanic patient-side domain through explicit0R links, NOT three isolation domains." (at 12 107 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "9f1ce0b6-c555-4221-8f84-f248595bc7ca")) (text "PCB high-speed returns must remain continuous under signals. Do not create split-plane slots crossed by USB/SPI/clock traces." (at 12 120 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "1d622b0b-7103-41bf-a862-19d459a7f162")) (text "Only external data interface in patient-mode architecture is isolated USB. UART/SPI/FPGA/radio ports are internal bench-only DNP." (at 12 133 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "5f9588ca-2008-4936-a4c6-63c02a4a9917")) (text "J50 SWD,J60 reset,J61,J200 and test pads are accessible only after the electrode cassette are physically unplugged." (at 12 146 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "30fce4e8-39e3-41b1-b5cf-a521c4a4506f")) (text "Enclosure/service tooling must enforce this mechanical exclusion. An ARM bit or open bias relay does NOT isolate debugger ground." (at 12 159 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "62120c4b-1399-401e-a1dc-a4f09bfc075a")) (text "Oscilloscope, logic analyzer, USB debugger, externally powered FPGA and prosthetic power grounds each bypass isolation if attached." (at 12 172 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "99266293-a8e0-4be6-b2f2-09256df274f6")) (text "Until mechanically enforced service exclusion and leakage tests are complete, all electrode connectors remain DNP release-hold." (at 12 185 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "8604fde2-39fd-48ec-b0da-d0bab4fc59c3")) (text "Use one twisted pair per differential channel, <=1m; no common-connected cable shield. Label/color-code and mechanically distinguish banks." (at 12 198 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "9a70acb2-6831-476d-be79-01c78d65d66b")) (text "Patient-end connectors must be shrouded touch-proof EEG accessories, not exposed pin headers. Inspect each crimp and insulation." (at 12 211 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "d163dc48-08b3-4cf9-a9fd-e0e9bc98dbae")) (text "X50ECS-2520MV-250-CN-TR:25MHzCMOS,+/-25ppm,2.5x2mm; HSE bypass; PLL configured toSTM32H743 datasheet voltage/frequency limits." (at 12 224 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "9cf91be5-2258-48af-88ea-6b44cedcd043")) (text "X51SiT8008BI-82-33E-2.048000:2.048MHz,+/-25ppm,3.3V,7x5mm; both ADS1299 CLKSEL low, shared clock andSTART." (at 12 237 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "0d5fb0a6-1f37-44c9-b916-747ff732d444")) (text "Both oscillators pin1OE,2GND,3OUT,4VDD. X51 sourcing/packing suffix confirmed with manufacturer at procurement." (at 12 250 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "10d4b30d-159a-4230-a423-bd96748f6f20")) (text "Y50ABS07-32.768KHZ-7-T:CL7pF,ESR<=70kOhm,initial+/-20ppm. C74=C75=10pF assumes total stray2pF." (at 12 263 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "b088f4aa-381b-4c11-ad9d-e0ef56930afb")) (text "CL=C74*C75/(C74+C75)+Cstray=7pF. PCB-dependent parasitics require tuning; verify STAN2867 gain margin and crystal drive<=0.5uW." (at 12 276 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "42986fb4-b896-48d2-9c51-766ba8ee9e5d")) (text "LSE timing is not sample synchronization. Shared2.048MHz and commonSTART synchronize ADCs; DRDY capture timestamps verify alignment." (at 12 289 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "895562f2-7349-496d-ae8f-6b8a1b8ff91b")) (text "No claim of enterprise-grade release: this is a traceable schematic engineering candidate with explicit test gates." (at 12 302 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "cc5ba3da-a27a-47ce-bac3-78cbe1dc9674")))