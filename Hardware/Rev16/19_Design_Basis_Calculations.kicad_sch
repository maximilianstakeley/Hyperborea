(kicad_sch (version 20250114) (generator "eeschema") (uuid "602c2970-0e07-4f14-bbc4-32844df91b36") (paper "User" 594 460) (title_block (title "19 | Design basis and calculated limits") (date "2026-11-17") (rev "16") (comment 1 "ENGINEERING REVISION - BENCH PROTOTYPE; NOT PATIENT-RELEASED")) (lib_symbols) (text "19 | Design basis and calculated limits" (at 12 20 0) (effects (font (size 2 2)) (justify left)) (uuid "da9637cb-2974-4f20-8489-bd0463d71e60")) (text "Application: NON-INVASIVE wet Ag/AgCl scalp EEG, 16 differential channels, electrode impedance<=10kOhm, ambient10-40C." (at 12 42 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "1fdabab9-a9fc-4e88-9c0e-29d32998b10d")) (text "Signal requirement: 0.5-100Hz useful band; +/-300mV electrode DC offsets; no stimulation/defibrillator/intracardiac use." (at 12 55 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "ffd818ba-a6dc-49f8-bc37-90df6093c6e0")) (text "ADC: ADS1299 at4kSPS, gain12, 4.5V internal reference. Nominal full-scale +/-375mV; reject startup/saturated samples." (at 12 68 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "93e0f7b8-8c76-4903-b52d-66cee17f41e7")) (text "Input series path per leg: 270k+270k,100nF C0G,10M midpoint return,100k, then330pF differential +10pF/leg common-mode." (at 12 81 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "16157ba4-ab80-4349-bc95-0fdc29dddf22")) (text "Coupling pole approximately1/(2pi*100nF*(10M+540k))=0.151Hz. Midband loading about10M/(10M+540k)=0.949." (at 12 94 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "ec84c71b-26d3-4cc6-a45e-5fde88959138")) (text "Differential equivalent source R approximately2*(100k+(540k||10M))=1.225M; Cdiff effective335pF; pole~388Hz." (at 12 107 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "e589e15b-ab92-4f3c-8440-bc67d3d15dfe")) (text "Approx response at0.5Hz=-0.38dB HP; at100Hz=-0.28dB LP; loading=-0.46dB. Calibrate full complex gain by channel." (at 12 120 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "18bc0ad5-87bd-41c3-a468-20317e9a468c")) (text "Resistor-only differential noise upper estimate sqrt(4kT*1.28M*100Hz)=1.46uVrms at300K. ADC/electrode/excess noise add." (at 12 133 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "638d87dd-947f-4576-a584-0d9c84f18a07")) (text "Anti-alias: analog first-order network plus ADS1299 sinc filter; FIR pass0-100Hz, stop>=500Hz before4:1 decimation REQUIRED." (at 12 146 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "0fe7ea6a-7bfe-41f3-8bc1-10f94aa68d72")) (text "Raw Nyquist2kHz analog attenuation only~14.4dB. No claim of arbitrary strong out-of-band immunity; sweep test required." (at 12 159 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "80c32593-d70d-47f4-8ea0-443709c74c50")) (text "Each HV resistor VR68000002703FAC00:270k1%,1W,voltage/pulse envelope per VishayVR68; oversized18x9mm footprint." (at 12 172 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "f9460175-feb0-481c-833f-9ab7607314eb")) (text "5.25V DC fault: two minimum267.3k resistors give9.82uA/lead; one resistor short gives19.64uA/lead; remaining power0.103mW." (at 12 185 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "e2bcd988-3b52-4249-b56e-9f8cfa69da97")) (text "These are per-lead calculations, NOT total patient leakage. Include all33 signal/ref legs, bias, adapter, USB and parasitic paths." (at 12 198 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "9e9af851-a608-4994-8c48-925e196066a3")) (text "ESD source150pF at8kV stores4.8mJ; at15kV16.9mJ. Current/pulse sharing depends on parasitic capacitance; no equal-sharing assumption." (at 12 211 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "9061fda2-d353-4aa8-8e37-b9f5e36e1dad")) (text "VR68 pulse rating and TPD4 transient behavior require assembled-board IEC61000-4-2 testing; no ESD immunity certification inferred." (at 12 224 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "6d353bc2-1ae5-47ed-be72-34cca8c8562d")) (text "TPD4E05U06 is a6V working-voltage ESD protector, NOT a5.3V precision clamp. Secondary BAV199 steers to rails." (at 12 237 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "d9c25912-7fed-4435-a89b-9f6da1790db8")) (text "BAV199 leakage: typical pA is NOT a guarantee; max5nA at25C can cause up to50mV on10M. Temperature/humidity characterize." (at 12 250 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "9df44746-5547-4dd2-91e0-969654fe1ce7")) (text "If a secondary clamp node reaches12V and ADC internal clamp is5.3V,100k limits injection to67uA; transient verification still required." (at 12 263 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "4fb0eb44-72bc-48b0-87e0-c759fe7e032d")) (text "Input capacitor C1210C104J5GACTU:100nF,C0G,50V. Verify its insulation leakage and startup recovery within gain12 headroom." (at 12 276 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "e1d092ae-b34f-4895-a2e2-71ca113c4b91")) (text "Passive bias through2x1M: nominal2.5V gives1.25uA at grounded body,2.53uA if one resistor shorts (1% tolerance)." (at 12 289 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "d8e58c5e-a25e-4327-bf62-244bf810b08c")) (text "No external active bias loop exists in this revision; OPA320 local unity-gain buffer is not loaded by a large direct output capacitor." (at 12 302 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "08f19e50-d966-4372-beee-87b1d2269c98")) (text "AFE rails window comparators inhibit acquisition; they do not crowbar an overvoltage or establish patient isolation." (at 12 315 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "dbc18f54-91a2-4e29-900d-ae77ba3f894b")) (text "Firmware: baseline settle>=60s after connection/configuration, after independent bias enable, qualify baseline before transmitting samples." (at 12 328 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "0ac1c490-70bd-4e7f-b5b7-9293dbd3cab3")) (text "Unverified physical gates: noise/CMRR, offsets, pulse stress, leakage/single fault, EMC, thermal, crystal drive/startup and PCB SI/PI." (at 12 341 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "02d862f7-bffe-4011-a38d-9de26d60cdc6")))